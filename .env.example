# ─────────────────────────────────────────────────────────────
# Hyrd · environment template
# Copy to `.env` and fill in real values before running `docker compose up`.
# All variables here are read by docker-compose.yml and passed into the
# correct service. The web container also reads OPENAI_*, LLM_PROVIDER,
# SUPABASE_URL_INTERNAL, and the LiveKit/voice keys.
# ─────────────────────────────────────────────────────────────


# ─── Postgres ────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432


# ─── Auth: JWT secret + signed keys ──────────────────────────
# JWT_SECRET must be at least 32 characters. The ANON_KEY and
# SERVICE_ROLE_KEY below are HS256 JWTs signed with that secret.
# If you change JWT_SECRET, regenerate the two keys with:
#     node infra/sign-jwts.mjs "<your-new-secret>"
JWT_SECRET=super-secret-jwt-key-at-least-32-characters-long-please

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6Imh5cmQiLCJpYXQiOjE3Nzc1MDYyNDEsImV4cCI6MjA5Mjg2NjI0MX0.h5S-UI5ek5MrB1qUX4N8Kq5px3ssoPc5y8Id4NlFsqc
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoiaHlyZCIsImlhdCI6MTc3NzUwNjI0MSwiZXhwIjoyMDkyODY2MjQxfQ.bWcwLNJhTeT3cKlRLVAof01ofWZ3CVIe5Q1ffjEcOL8


# ─── Service ports (host-side) ───────────────────────────────
# Defaults pick less-common ports to avoid collisions with other
# local stacks. Open the app at http://localhost:${WEB_PORT}.
WEB_PORT=3002
KONG_PORT=8001
GOTRUE_PORT=9999
POSTGREST_PORT=3001

# Web build target — `runner` (production standalone) or `dev` (hot reload).
WEB_TARGET=runner


# ─── LLM PROVIDER · which backend powers résumé / scoring ────
# `azure`     -> Azure AI Foundry deployments via the openai SDK
# `anthropic` -> Claude Opus 4.7 / Haiku 4.5 via @anthropic-ai/sdk
LLM_PROVIDER=azure


# ─── REQUIRED · Azure AI Foundry (Azure OpenAI v1) ───────────
# Required when LLM_PROVIDER=azure (the default).
# The SDK speaks Azure's v1 surface unchanged when baseURL ends
# in `/openai/v1/`. The `model` parameter at call time is your
# Azure *deployment name*, not OpenAI's published model ID.
# Docs: https://learn.microsoft.com/azure/foundry/openai/api-version-lifecycle
OPENAI_API_KEY=
OPENAI_BASE_URL=https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/v1/
OPENAI_CHAT_MODEL=
OPENAI_SURVEY_MODEL=


# ─── ALTERNATE LLM · Anthropic Claude ────────────────────────
# Required when LLM_PROVIDER=anthropic. Also used by the LiveKit
# voice agent (Claude Haiku) regardless of LLM_PROVIDER, because
# livekit-agents has provider plugins not generic LLM injection.
ANTHROPIC_API_KEY=


# ─── OPTIONAL · Live voice interview ─────────────────────────
# Without these, the live-interview screen runs in simulation
# mode (rotating questions on a timer; no real audio). The rest
# of the platform — kanban, optimizer, performance dashboard —
# works perfectly without them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# STT + TTS used by the Python agent in the `voice` compose profile.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Voice agent dispatch path — `livekit` is the default. Reserved
# for a future OpenAI Realtime fallback path.
INTERVIEW_AGENT=livekit


# ─── OPTIONAL · misc ─────────────────────────────────────────
# Company-logo lookup for jobs added by the user.
LOGODEV_API_KEY=
